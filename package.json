{
  "name": "nestjs-api-template",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "imports": {
    "#src/*": {
      "types": "./src/*",
      "default": "./dist/src/*"
    },
    "#services/*": {
      "types": "./services/*",
      "default": "./dist/services/*"
    }
  },
  "scripts": {
    "build": "nest build api && nest build db-migration",
    "format": "prettier --write \"src/**/*.ts\" \"services/**/*.ts\" \"tasks/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start api",
    "start:dev": "nest start api --watch",
    "start:dev:with-migration": "npm run db-migrate && npm run start:dev",
    "start:prod": "node dist/services/api/src/main",
    "db-migrate": "nest build db-migration && node --env-file=.env dist/tasks/db-migration/main",
    "lint": "eslint \"{src,services,tasks,test}/**/*.ts\" --fix",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "engines": {
    "npm": ">=11.0.0",
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.1111.0",
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.1",
    "jose": "^6.1.0",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.0",
    "typeorm-naming-strategies": "^4.1.0",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.19",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.5.0",
    "jest": "^30.3.0",
    "prettier": "^3.8.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "roots": [
      "<rootDir>",
      "<rootDir>/../services",
      "<rootDir>/../tasks"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^#src/(.*)\\.js$": "<rootDir>/$1",
      "^#src/(.*)$": "<rootDir>/$1",
      "^(\\.\\.?/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "volta": {
    "node": "24.19.0",
    "npm": "11.19.0"
  }
}
