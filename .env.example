NODE_ENV=development
PORT=3000
APP_NAME=api

# Set by CI/CD (docker build --build-arg GIT_SHA=...) and surfaced at GET /. Safe to
# leave unset locally — defaults to "unknown".
# GIT_SHA=

# "ssl" must be false for local/docker Postgres and true against AWS RDS (RDS requires
# TLS; the app maps ssl:true to { rejectUnauthorized: false } since RDS's default cert
# chain isn't in Node's trust store).
#
# "readonlyHost" is optional — point it at a read replica once you have one and
# SELECTs are routed there automatically (writes always go to "host"). Leave it
# empty/unset (or just omit the key) to route everything at "host", same as before.
#
# In staging/production, POSTGRES_CONFIG/VALKEY_CONFIG/AUTH_CONFIG can all be left
# unset entirely: when NODE_ENV is "staging" or "production", each falls back to AWS
# SSM Parameter Store at /${NODE_ENV}/<postgres|valkey|auth> (same JSON shape, as a
# SecureString). See README.md's "Config & secrets" section.
POSTGRES_CONFIG={"host":"localhost","readonlyHost":"","port":5432,"username":"app","password":"app","database":"app","ssl":false}
VALKEY_CONFIG={"host":"localhost","port":6379}

# Comma-separated list of allowed origins, or omit for a permissive dev default.
CORS_ORIGIN=*

# Serves interactive API docs at /docs. Defaults to on outside production.
SWAGGER_ENABLED=true

# One JSON object per log line instead of colored text — turn on for log aggregators
# (CloudWatch Logs Insights, etc). Off by default so local dev output stays readable.
# LOG_JSON_FORMAT=true

# Optional. When unset, JwtAuthGuard rejects every request it protects (fails closed).
# JWKS-based bearer token verification — works with any OIDC-ish issuer.
#
# Generic OIDC issuer:
# AUTH_CONFIG={"jwksUri":"https://your-issuer.example.com/.well-known/jwks.json","issuer":"https://your-issuer.example.com/","audience":"your-api-audience"}
#
# AWS Cognito user pool:
# AUTH_CONFIG={"jwksUri":"https://cognito-idp.<region>.amazonaws.com/<user-pool-id>/.well-known/jwks.json","issuer":"https://cognito-idp.<region>.amazonaws.com/<user-pool-id>","audience":"<app-client-id>"}
