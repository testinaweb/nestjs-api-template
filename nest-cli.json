{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "services/api",
  "sourceRoot": "services/api/src",
  "compilerOptions": {
    "deleteOutDir": false,
    "tsConfigPath": "tsconfig.build.json"
  },
  "projects": {
    "api": {
      "type": "application",
      "root": "services/api",
      "entryFile": "main",
      "sourceRoot": "services/api/src",
      "compilerOptions": {
        "tsConfigPath": "tsconfig.build.json"
      }
    },
    "db-migration": {
      "type": "application",
      "root": "tasks/db-migration",
      "entryFile": "main",
      "sourceRoot": "tasks/db-migration",
      "compilerOptions": {
        "tsConfigPath": "tasks/db-migration/tsconfig.json"
      }
    }
  }
}
